          "type": "string",
          "max": 64
        }
      },
      "result": {},
      "emits": [
        "presence"
      ],
      "about": "Any of: here or away; a mood (an emoji and a short note) or clearMood; where you are (a channel id, or empty for nowhere)."
    },
    "channel.create": {
      "perm": "channel.manage",
      "args": {
        "name": {
          "type": "string",
          "required": true,
          "min": 1,
          "max": 40,
          "pattern": "^[\\p{L}\\p{N}][\\p{L}\\p{N} _-]*$"
        },
        "kind": {
          "type": "string",
          "required": true,
          "enum": [
            "text",
            "voice",
            "spar",
            "events"
          ]
        },
        "category": {
          "type": "string",
          "max": 30
        },
        "topic": {
          "type": "string",
          "max": 200
        }
      },
      "result": {
        "channel": "channel"
      },
      "emits": [
        "channel.created"
      ]
    },
    "channel.update": {
      "perm": "channel.manage",
      "args": {
        "channelId": {
          "type": "string",
          "required": true,
          "max": 64
        },
        "name": {
          "type": "string",
          "min": 1,
          "max": 40,
          "pattern": "^[\\p{L}\\p{N}][\\p{L}\\p{N} _-]*$"
        },
        "category": {
          "type": "string",
          "max": 30
        },
        "topic": {
          "type": "string",
          "max": 200
        },
        "position": {
          "type": "int",
          "min": 0,
          "max": 9999
        }
      },
      "result": {
        "channel": "channel"
      },
      "emits": [
        "channel.updated"
      ]
    },
