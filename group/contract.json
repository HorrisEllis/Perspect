        "roles": "[role]"
      }
    },
    "role.create": {
      "perm": "role.manage",
      "args": {
        "name": {
          "type": "string",
          "required": true,
          "min": 1,
          "max": 30
        },
        "rank": {
          "type": "int",
          "required": true,
