          "max": 999
        },
        "permissions": {
          "type": "array",
          "required": true,
          "max": 20,
          "of": {
            "type": "string",
            "enum": "permissions"
          }
        }
      },
      "result": {
        "role": "role"
      },
      "emits": [
        "role.changed"
      ]
    },
    "role.update": {
      "perm": "role.manage",
      "args": {
        "roleId": {
          "type": "string",
          "required": true,
          "max": 64
        },
        "name": {
          "type": "string",
          "min": 1,
          "max": 30
        },
        "rank": {
          "type": "int",
          "min": 1,
          "max": 999
        },
        "permissions": {
          "type": "array",
          "max": 20,
          "of": {
            "type": "string",
            "enum": "permissions"
          }
        }
      },
      "result": {
        "role": "role"
      },
      "emits": [
        "role.changed"
      ]
    },
    "role.delete": {
