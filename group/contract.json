{
  "name": "perspect.group",
  "version": "1.0.0",
  "about": "The interaction contract between a Perspect group server and anything that talks to it: pages, the CLI, other programs. Pages float on it — they send these commands and receive these events, nothing else — so a page can be thrown away and rewritten without touching the server. One core runs every command (group/core.js) behind three doors that behave the same: WebSocket, HTTP and the CLI. The server checks every call against this file; test/group.test.mjs fails if the code and this file disagree. It is meant to hold everything a group makes together: conversation, sparring, ideas built piece by piece, presence and the small things that build closeness.",
  "handshake": {
    "about": "Both sides prove they speak this exact contract before anything else, and the member proves their key. 1) client → auth.hello { pub, contract: { version, hash } }: the server refuses a different hash with contract_mismatch (and says its own). 2) server → { contract, ephPub, nonce, envelope }: the client checks the server's hash is its own and refuses to go on if not. 3) client opens the envelope with its private key → auth.prove { proof }. 4) server → { me, group, token }. The token signs HTTP calls (Authorization: Bearer) until it expires.",
    "hash": "sha256 of this file with its keys sorted (group/contract.js: hashOf)"
  },
  "transport": {
    "ws": "ws(s)://<host>/group — request { id, cmd, args } → reply { id, ok, result } or { id, ok: false, error: { code, message, data? } }; events arrive as { event, data }",
    "http": "POST /api/group/<cmd> with JSON args (Authorization: Bearer <token> once signed in) → the same reply without id. GET /api/group/contract → { contract, hash }. Events are WebSocket only.",
    "cli": "node group/cli.js — runs on the server, as the owner of its database (see group/cli.js --help)",
    "limits": {
      "frameBytes": 65536,
      "commandsPerSecond": 20,
      "authSeconds": 10,
      "tokenHours": 168
    }
  },
  "permissions": {
    "channel.view": "see a channel and read it (channel scoped)",
    "message.send": "post and type in a channel (channel scoped)",
    "message.manage": "delete anyone's message in a channel (channel scoped)",
    "voice.join": "join a voice room (channel scoped)",
    "invite.create": "make, list and revoke invites",
    "member.manage": "change members' roles and remove members ranked below you",
    "channel.manage": "create, change, delete channels and set their overrides",
    "role.manage": "create, change and delete roles ranked below you",
    "group.manage": "change the group's name and about",
    "audit.view": "read the audit log",
    "emoji.manage": "add and remove the group's own emoji"
  },
  "roles": {
    "about": "A member has one role. A role has a rank and a set of permissions. You can only act on members and roles ranked below your own, and only grant permissions you hold. The owner (rank 1000) holds every permission and is the only one who can hand ownership on. A channel can add (allow) or take away (deny) channel-scoped permissions for a role.",
    "builtin": {
      "owner": {
        "rank": 1000,
        "permissions": "all"
      },
      "admin": {
        "rank": 800,
        "permissions": [
          "channel.view",
          "message.send",
          "message.manage",
          "voice.join",
          "invite.create",
          "member.manage",
          "channel.manage",
          "role.manage",
          "group.manage",
          "audit.view",
          "emoji.manage"
        ]
      },
      "moderator": {
        "rank": 500,
        "permissions": [
          "channel.view",
          "message.send",
          "message.manage",
          "voice.join",
          "invite.create",
          "audit.view",
          "emoji.manage"
        ]
      },
      "member": {
        "rank": 100,
        "permissions": [
          "channel.view",
          "message.send",
          "voice.join"
        ]
      }
    }
  },
  "types": {
    "id": "a string the server made; never parse it",
    "member": {
      "id": "id",
      "name": "string",
      "note": "string",
      "roleId": "id",
      "status": "here | away | offline",
      "joinedAt": "ms",
      "mood": "{ emoji, note } | null",
      "where": "channelId | null"
    },
    "role": {
      "id": "id",
      "name": "string",
      "rank": "int",
      "permissions": "[permission]",
      "builtin": "bool"
    },
    "channel": {
      "id": "id",
      "name": "string",
      "kind": "text | voice | spar | events",
      "category": "string",
      "topic": "string",
      "position": "int",
      "overrides": "{ roleId: { allow: [permission], deny: [permission] } }"
    },
    "message": {
      "id": "id",
      "seq": "int, rises within the group",
      "channelId": "id",
      "authorId": "id",
      "kind": "msg | oneway | spar | idea | event | prompt",
      "body": "string, kept exactly as sent (it may be ciphertext)",
      "replyTo": "id | null",
      "createdAt": "ms",
      "editedAt": "ms | null",
      "reactions": "{ emoji: [memberId] }",
      "buildsOn": "id | null — a piece added to an idea",
      "forkOf": "id | null — a new idea grown from another",
      "repliesOpenAt": "ms | null — a one-way message takes no replies before this"
    },
    "group": {
      "name": "string",
      "about": "string",
      "createdAt": "ms",
      "ownerId": "id | null"
    },
    "audit": {
      "seq": "int",
      "at": "ms",
      "actorId": "id | cli",
      "action": "string (a command)",
      "target": "string",
      "detail": "object"
    },
    "spar": {
      "id": "id",
      "channelId": "id",
      "topic": "string",
      "by": "id",
      "opponentId": "id | null (open to anyone)",
      "status": "open | active | ended",
      "turnSeconds": "int",
      "turnsTotal": "int",
      "speed": "bool",
      "current": "id | null",
      "turnEndsAt": "ms | null",
      "turns": "[{ n, by, text, at, auto }]",
      "rules": "[{ id, text, by, status: pending | accepted | declined, expiresAt }]",
      "endedReason": "string | null"
    },
    "emoji": {
      "name": "string",
      "image": "data:image/png|gif|webp;base64,…",
      "addedBy": "id",
      "at": "ms"
    },
    "appreciation": {
      "id": "id",
      "from": "id",
      "to": "id",
      "note": "string",
      "at": "ms"
    }
  },
  "commands": {
    "auth.hello": {
      "perm": "anyone",
      "about": "Start signing in. The first time, pass an invite code (the server's setup code makes you the owner).",
      "args": {
        "pub": {
          "type": "string",
          "required": true,
          "min": 40,
          "max": 64
        },
        "contract": {
          "type": "object",
          "required": true,
          "fields": {
            "version": {
              "type": "string",
              "required": true,
              "max": 20
            },
            "hash": {
              "type": "string",
              "required": true,
              "min": 64,
              "max": 64
            }
          }
        },
        "invite": {
          "type": "string",
          "max": 64
        },
        "name": {
          "type": "string",
          "max": 40
        }
      },
      "result": {
        "contract": "{ version, hash }",
        "challengeId": "string (send it back with auth.prove; HTTP needs it)",
        "ephPub": "string",
        "nonce": "string",
        "envelope": "{ iv, ct }"
      }
    },
    "auth.prove": {
      "perm": "anyone",
      "args": {
        "proof": {
          "type": "string",
          "required": true,
          "max": 64
        },
        "challengeId": {
          "type": "string",
          "max": 64
        }
      },
      "result": {
        "me": "member",
        "group": "group",
        "token": "string"
      },
      "emits": [
        "member.joined",
        "presence"
      ]
    },
    "auth.logout": {
      "perm": "member",
      "about": "Ends this token.",
      "args": {},
      "result": {}
    },
    "group.get": {
      "perm": "member",
      "args": {},
      "result": {
        "group": "group",
        "channels": "[channel you can view]",
        "members": "[member]",
        "roles": "[role]",
        "me": "member",
        "myPermissions": "[permission]",
        "voice": "{ channelId: [memberId] }"
      }
    },
    "group.update": {
      "perm": "group.manage",
      "args": {
        "name": {
          "type": "string",
          "min": 1,
          "max": 80
        },
        "about": {
          "type": "string",
          "max": 2000
        }
      },
      "result": {
        "group": "group"
      },
      "emits": [
        "group.updated"
      ]
    },
    "group.transfer_owner": {
      "perm": "owner",
