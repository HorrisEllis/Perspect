        "memberId": {
          "type": "string",
          "required": true,
          "max": 64
        }
      },
      "result": {
        "group": "group"
      },
      "emits": [
        "member.updated",
        "group.updated"
      ]
    },
    "invite.create": {
      "perm": "invite.create",
      "args": {
