          "max": 4,
          "of": {
            "type": "string",
            "enum": [
              "channel.view",
              "message.send",
              "message.manage",
              "voice.join"
            ]
          }
        },
        "deny": {
          "type": "array",
          "max": 4,
          "of": {
            "type": "string",
            "enum": [
              "channel.view",
              "message.send",
              "message.manage",
              "voice.join"
            ]
          }
        }
